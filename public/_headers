# Cloudflare Pages / Netlify header rules.
# WebAssembly must be served with the correct MIME type or Pyodide
# falls back to a slower, sometimes failing, instantiation path.
/*.wasm
  Content-Type: application/wasm

# Pyodide is version-pinned and immutable: cache it hard.
/pyodide/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
